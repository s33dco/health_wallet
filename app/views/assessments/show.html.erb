<div class="assessment-detail">
  <div class="assessment-header">
    <%= link_to "← Back to #{@patient.name}", patient_path(@patient), class: "back-link" %>
    <div class="header-row">
      <h1>Assessment <%= @assessment.reference %></h1>
      <%= link_to "Edit", edit_assessment_path(@assessment), class: "btn btn-secondary" %>
    </div>
  </div>

  <% if notice %>
    <div class="flash-notice"><%= notice %></div>
  <% end %>

  <div class="assessment-info">
    <div class="info-item">
      <span class="info-label">Patient</span>
      <span class="info-value"><%= @patient.name %></span>
    </div>
    <div class="info-item">
      <span class="info-label">Date</span>
      <span class="info-value"><%= @assessment.date %></span>
    </div>
    <div class="info-item">
      <span class="info-label">Reference</span>
      <span class="info-value"><%= @assessment.reference %></span>
    </div>
  </div>

  <div class="observations-section">
    <h2>Observations (<%= @observations.count %>)</h2>

    <% if @observations.any? %>
      <table class="observations-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Code</th>
            <th>Value</th>
            <th>Units</th>
          </tr>
        </thead>
        <tbody>
          <% @observations.each do |observation| %>
            <% history = observation.observation_histories.sort_by(&:created_at) %>
            <tr>
              <td><%= observation.name %></td>
              <td><code><%= observation.code %></code></td>
              <td>
                <% if history.any? %>
                  <details class="obs-history">
                    <summary class="obs-value <%= "obs-value--changed" if history.size > 1 %>">
                      <%= observation.value %>
                      <span class="obs-history-badge" aria-label="<%= pluralize(history.size, "recorded reading") %>"><%= history.size %></span>
                      <span class="obs-history-caret" aria-hidden="true">▸</span>
                    </summary>
                    <div class="obs-history-panel">
                      <span class="obs-history-heading">Reading history</span>
                      <ol class="obs-history-list">
                        <% history.each do |reading| %>
                          <li>
                            <span class="obs-history-value"><%= reading.value %> <%= reading.units %></span>
                            <span class="obs-history-meta"><%= reading.created_at.strftime("%d %b %Y, %H:%M") %><% if reading.source.present? %> · <%= reading.source %><% end %></span>
                          </li>
                        <% end %>
                      </ol>
                    </div>
                  </details>
                <% else %>
                  <%= observation.value %>
                <% end %>
              </td>
              <td><%= observation.units %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="no-observations">No observations recorded for this assessment.</div>
    <% end %>
  </div>
</div>
